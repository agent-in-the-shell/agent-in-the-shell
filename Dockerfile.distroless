# One static binary on a distroless base — the "one binary" value literally is
# the image. goreleaser passes --build-arg=BINARY=<service> and stages the
# prebuilt binary into the platform-scoped build context for each image.
# Pinned to the multi-arch INDEX digest, not a per-platform manifest digest:
# goreleaser builds linux/amd64 AND linux/arm64 from this one Dockerfile, and a
# per-platform digest would resolve for one of them and break the other.
# Re-resolve with:
#   docker buildx imagetools inspect gcr.io/distroless/static:nonroot
# and take the top-level Digest (MediaType …image.index.v1+json).
FROM gcr.io/distroless/static:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6
ARG TARGETPLATFORM
ARG BINARY
COPY ${TARGETPLATFORM}/${BINARY} /app
ENTRYPOINT ["/app"]
