# GENERATED by release-export — do not edit by hand.
# One static binary on a distroless base — the "one binary" value literally is
# the image. goreleaser passes --build-arg=BINARY=<service> and stages the
# prebuilt binary into the platform-scoped build context for each image.
FROM gcr.io/distroless/static:nonroot
ARG TARGETPLATFORM
ARG BINARY
COPY ${TARGETPLATFORM}/${BINARY} /app
ENTRYPOINT ["/app"]
